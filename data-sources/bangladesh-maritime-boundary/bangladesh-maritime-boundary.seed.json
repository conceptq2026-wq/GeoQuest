  "info": [
    {
      "group": "notes",
      "bn": "এই সমুদ্র এলাকার কিছু অংশ বাংলাদেশের ভিত্তিরেখা থেকে ২০০ নটিক্যাল মাইলের বাইরে, কিন্তু প্রতিবেশী দেশের ২০০ নটিক্যাল মাইলের ভেতরে («ধূসর এলাকা»)। সেখানে বাংলাদেশের অধিকার কেবল সমুদ্রতল ও তার নিচে; ওপরের পানিতে প্রতিবেশী দেশের অধিকার বহাল।",
      "approved": true,
      "cite": [
        {
          "source": "itlos",
          "at": "¶471–476, pp. 120–121"
        },
        {
          "source": "pca",
          "at": "¶498–508, pp. 155–157"
        }
      ]
    },
    {
      "group": "notes",
      "bn": "সেন্টমার্টিন্স দ্বীপের চারপাশে মিয়ানমারের সঙ্গে সীমার যে অংশ দ্বীপ থেকে ১২ নটিক্যাল মাইল দূর দিয়ে গেছে, রায়ে তার স্থানাঙ্ক দেওয়া নেই। ড্যাশ দেওয়া এই অংশ OpenStreetMap-এর তটরেখা থেকে হিসাব করে আনুমানিকভাবে আঁকা।",
      "approved": true,
      "cite": [
        {
          "source": "itlos",
          "at": "¶502, p. 128"
        }
      ]
    },
    {
      "group": "notes",
      "bn": "২০১৫ সালের ভিত্তিরেখার চারটি বিন্দুর মাঝের সরল অংশই আঁকা হয়েছে; ৪ নম্বর বিন্দু (কক্সবাজার) থেকে টেকনাফ ও সেন্টমার্টিন্স দ্বীপ পর্যন্ত ভিত্তিরেখা ভাটার সময়ের জলরেখা ধরে চলে।",
      "approved": true,
      "cite": [
        {
          "source": "sro328",
          "at": "S.R.O. No. 328, table (C), Bangladesh Gazette Extraordinary, 10 November 2015, p. ৮৭৬৪ (PDF p. 2)",
          "scan": true
        }
      ]
    },
    {
      "group": "notes",
      "bn": "ভিত্তিরেখার ২ নম্বর বিন্দু ও ৫ নম্বর বিন্দু (সেন্টমার্টিন্স দ্বীপের দক্ষিণ প্রান্ত) নিয়ে ভারত (২০১৭ ও ২০২১) ও মিয়ানমার (২০১৯ ও ২০২১) জাতিসংঘে লিখিত আপত্তি জানিয়েছে।",
      "approved": true,
      "cite": [
        {
          "source": "ind2017",
          "at": "p. 1"
        },
        {
          "source": "mmr2019",
          "at": "pp. 1–2"
        },
        {
          "source": "ind2021",
          "at": "¶3",
          "scan": true
        },
        {
          "source": "mmr2021",
          "at": "¶1",
          "scan": true
        }
      ]
    },
    {
      "group": "notes",
      "bn": "২০২১ সালের সংশোধিত আইন অনুযায়ী বাংলাদেশের আঞ্চলিক সমুদ্র ভিত্তিরেখা থেকে ১২ নটিক্যাল মাইল, সংলগ্ন অঞ্চল ২৪ নটিক্যাল মাইল ও একান্ত অর্থনৈতিক অঞ্চল ২০০ নটিক্যাল মাইল পর্যন্ত।",
      "approved": true,
      "cite": [
        {
          "source": "act2021",
          "at": "section 3",
          "file": "act-s3.txt",
          "offset": 514,
          "length": 80,
