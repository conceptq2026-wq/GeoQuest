       "sha256": "b75f77dc6a11d64f1b958dc3128d125bda25b7945f59bad1e0519052b684fdf8"
      }
     ]
    },
    {
     "bn": "সব রাষ্ট্রের নৌচলাচল, উড্ডয়ন, মাছ ধরা ও বৈজ্ঞানিক গবেষণার স্বাধীনতা।",
     "approved": true,
     "cite": [
      {
       "source": "overview",
       "at": "key features, bullet 10",
       "file": "overview.html",
       "offset": 6368,
       "length": 84,
       "sha256": "5b865ec44320b67da1fef72f6001f00de6a7447c3a57fac2c44c639a72a3a0a4"
      },
      {
       "source": "convention",
       "at": "art. 87(1)",
       "file": "part7.html",
       "offset": 579,
       "length": 68,
       "sha256": "2d874e357b4d5feb6518f5dd1959669f50cf57f6f9694b5479c72399637283ee"
      }
     ]
    },
    {
     "bn": "কোনো রাষ্ট্র এর কোনো অংশে সার্বভৌমত্ব দাবি করতে পারে না।",
     "approved": true,
     "cite": [
      {
