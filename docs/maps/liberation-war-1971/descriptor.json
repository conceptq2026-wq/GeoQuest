  "controls": [
    {
      "type": "picker",
      "id": "items",
      "from": "items",
      "placeholder": "একটি সেক্টর বেছে নিন…",
      "labelEn": "Choose a sector, force, place or Bir Sreshtho",
      "label": {
        "field": "nameBn"
      },
      "do": [
        {
          "action": "select"
        },
        {
          "action": "fitBounds",
          "clear": [
            "sheet"
          ],
          "duration": 1800,
          "field": "frame"
        }
      ]
    }
  ],
