      "slot": "aboveLabels",
      "style": "marker",
      "layout": {
        "icon-image": "anchor",
        "icon-size": [
          "case",
          [
            "==",
            [
              "get",
              "selected"
            ],
            true
          ],
          1,
          0.8
        ]
      },
      "paint": {
        "icon-opacity": [
          "case",
          [
            "==",
            [
              "get",
              "dimmed"
            ],
            true
          ],
          0.45,
          1
        ]
      }
    },
    {
      "id": "hq-flag",
      "type": "symbol",
      "source": "hq",
      "slot": "aboveLabels",
      "style": "marker",
      "layout": {
        "icon-image": "flag",
        "icon-anchor": "bottom-left",
        "icon-size": [
          "case",
          [
            "==",
            [
              "get",
              "selected"
            ],
            true
          ],
          1.1,
          0.85
        ]
      },
      "paint": {
        "icon-opacity": [
          "case",
          [
            "==",
            [
              "get",
              "dimmed"
            ],
            true
          ],
          0.45,
          1
        ]
      }
    },
    {
      "id": "number-disc",
      "type": "circle",
      "source": "numbers",
      "slot": "aboveLabels",
      "style": "number-disc",
      "paint": {
        "circle-radius": [
          "case",
          [
            "==",
            [
              "get",
              "selected"
            ],
            true
          ],
          13,
          11
        ],
        "circle-opacity": [
          "case",
          [
            "==",
            [
              "get",
              "dimmed"
            ],
            true
          ],
          0.7,
          1
        ],
        "circle-stroke-opacity": [
          "case",
          [
            "==",
            [
              "get",
              "dimmed"
            ],
            true
          ],
          0.7,
          1
        ]
      }
    },
    {
      "id": "number-text",
      "type": "symbol",
      "source": "numbers",
      "slot": "aboveLabels",
      "style": "number-text",
      "layout": {
        "text-field": [
          "get",
          "numberBn"
        ]
      },
      "paint": {
        "text-opacity": [
          "case",
          [
            "==",
            [
              "get",
              "dimmed"
            ],
            true
          ],
          0.7,
          1
        ]
      }
    },
    {
      "id": "place-glow",
      "type": "circle",
      "source": "places",
      "slot": "aboveLabels",
      "style": "place-glow",
      "filter": [
        "==",
        [
          "get",
          "selected"
        ],
        true
      ]
    },
    {
      "id": "place-dot",
      "type": "circle",
      "source": "places",
      "slot": "aboveLabels",
      "style": "place-dot",
      "paint": {
        "circle-radius": [
          "case",
          [
            "==",
            [
              "get",
              "selected"
            ],
            true
          ],
          8.5,
