{
  "schema": "geoquest/map-descriptor@1",
  "id": "liberation-war-1971",
  "section": "bangladesh",
  "title": {
    "bn": "মুক্তিযুদ্ধ ১৯৭১",
    "en": "Liberation War 1971"
  },
  "basemap": "bangladesh",
  "view": {
    "fitBounds": [
      88,
      20.55,
      92.75,
      26.7
    ]
  },
  "constraints": {
    "maxZoom": 11
  },
  "lookups": {},
  "images": {
    "flag": {
      "file": "./flag.svg",
      "pixelRatio": 2
    },
    "anchor": {
      "file": "./anchor.svg",
      "pixelRatio": 2
    },
    "star": {
      "file": "./star.svg",
      "pixelRatio": 2
    }
  },
  "records": {
    "items": {
      "file": "./records.json",
      "fields": {
        "tab": {
          "type": "text",
          "required": true,
          "display": false
        },
        "nameBn": {
          "type": "text",
          "required": true
        },
        "nameEn": {
          "type": "text",
          "display": false
        },
        "numberBn": {
          "type": "text",
          "display": false
        },
        "areaBn": {
          "type": "text"
        },
        "hqBn": {
          "type": "text"
        },
        "commandersBn": {
          "type": "text"
        },
        "specialBn": {
          "type": "text"
        },
        "noteBn": {
          "type": "text"
        },
        "commanderBn": {
          "type": "text"
        },
        "formedUnitsBn": {
          "type": "text"
        },
        "foughtBn": {
          "type": "text"
        },
        "battlesBn": {
          "type": "text"
        },
        "dateTextBn": {
          "type": "text"
        },
        "placeBn": {
          "type": "text"
        },
        "statementBn": {
          "type": "text"
        },
        "rankServiceBn": {
          "type": "text"
        },
        "sectorBn": {
          "type": "text"
        },
        "martyrdomBn": {
          "type": "text"
        },
        "burialBn": {
          "type": "text"
        },
        "hasArea": {
          "type": "boolean",
          "display": false
        },
        "hasPorts": {
          "type": "boolean",
          "display": false
        },
        "labelAt": {
          "type": "point"
        },
        "hqAt": {
          "type": "point"
        },
        "burialAt": {
          "type": "point"
        },
        "siblings": {
          "type": "refs",
          "to": "items",
          "display": false
        },
        "frame": {
          "type": "bbox"
        }
      }
    },
    "tabs": {
      "file": "./tabs.json",
      "fields": {
        "titleBn": {
          "type": "text",
          "required": true
        },
        "placeholderBn": {
          "type": "text",
          "required": true,
          "display": false
        },
        "noteBn": {
          "type": "text",
          "display": false
        }
      }
    }
  },
  "sources": {
    "areas": {
      "records": "items",
      "geometry": "./sectors.geojson",
      "joinField": "id",
      "expectGeometry": {
        "hasArea": true
      },
      "state": [
        "selected",
        {
          "name": "dimmed",
          "fromSelection": {
            "records": "items",
            "listField": "siblings"
          }
        }
      ],
      "properties": [],
      "attribution": "Sector outlines: traced from the sector map in NCTB «বাংলাদেশ ও বিশ্বপরিচয়», অষ্টম শ্রেণি (2026), p. ২৬, on districts from <a href=\"https://data.humdata.org/dataset/cod-ab-bgd\" target=\"_blank\" rel=\"noopener noreferrer\">Bangladesh – Subnational Administrative Boundaries</a> (BBS / OCHA FISS), <a href=\"http://creativecommons.org/licenses/by/3.0/igo/legalcode\" target=\"_blank\" rel=\"noopener noreferrer\">CC BY 3.0 IGO</a> — approximate."
    },
    "numbers": {
      "records": "items",
      "geometryFrom": "labelAt",
      "state": [
        "selected",
        {
          "name": "dimmed",
          "fromSelection": {
            "records": "items",
            "listField": "siblings"
          }
        }
      ],
      "properties": [
        "numberBn"
      ]
    },
    "hq": {
      "records": "items",
      "geometryFrom": "hqAt",
      "state": [
        "selected",
        {
          "name": "dimmed",
          "fromSelection": {
            "records": "items",
            "listField": "siblings"
          }
        }
      ],
      "properties": [],
      "attribution": "<a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener noreferrer\">© OpenStreetMap contributors</a>"
    },
    "ports": {
      "records": "items",
      "geometry": "./ports.geojson",
      "joinField": "id",
      "expectGeometry": {
        "hasPorts": true
      },
      "state": [
        "selected",
        {
          "name": "dimmed",
          "fromSelection": {
            "records": "items",
            "listField": "siblings"
          }
        }
      ],
      "properties": []
    },
    "places": {
      "records": "items",
      "geometry": "./places.geojson",
      "joinField": "id",
      "expectGeometry": {
        "tab": "places"
      },
      "state": [
        "selected"
      ],
      "properties": [],
      "attribution": "<a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener noreferrer\">© OpenStreetMap contributors</a>"
    },
    "graves": {
      "records": "items",
      "geometryFrom": "burialAt",
      "state": [
        "selected"
      ],
      "properties": [],
      "attribution": "<a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener noreferrer\">© OpenStreetMap contributors</a>"
    }
  },
  "styles": {
    "sector-fill": {
      "paint": {
        "fill-antialias": true
      }
    },
    "sector-edge": {
      "layout": {
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff"
      }
    },
    "number-disc": {
      "paint": {
        "circle-color": "#ffffff",
        "circle-stroke-color": "#44587c",
        "circle-stroke-width": 1.2
      }
    },
    "number-text": {
      "layout": {
        "text-font": [
          "Noto Sans Bengali"
        ],
        "text-size": 13,
        "text-allow-overlap": true,
        "text-ignore-placement": true
      },
      "paint": {
        "text-color": "#1d2b4f"
      }
    },
    "place-dot": {
      "paint": {
        "circle-color": "#d62828",
        "circle-stroke-color": "#ffffff",
        "circle-stroke-width": 2
      }
    },
    "place-glow": {
      "paint": {
        "circle-color": "#d62828",
        "circle-radius": 18,
        "circle-blur": 0.85,
        "circle-opacity": 0.5
      }
    },
    "marker": {
      "layout": {
        "icon-allow-overlap": true,
        "icon-ignore-placement": true
      }
    }
  },
  "layers": [
    {
      "id": "sector-fill",
      "type": "fill",
      "source": "areas",
      "slot": "belowLabels",
      "style": "sector-fill",
      "paint": {
        "fill-color": [
          "case",
          [
            "==",
            [
              "get",
              "selected"
            ],
            true
          ],
          [
            "match",
            [
              "get",
              "key"
            ],
            "sector-1",
            "#d9535c",
            "sector-2",
            "#3f9c55",
            "sector-3",
            "#4a74c9",
            "sector-4",
            "#dd8527",
            "sector-5",
            "#8b5cc7",
            "sector-6",
            "#2c9fb1",
            "sector-7",
            "#c34f9b",
            "sector-8",
            "#8aa628",
            "sector-9",
            "#34897a",
            "sector-11",
            "#a07443",
            "#d8dee8"
          ],
          [
            "match",
            [
              "get",
              "key"
            ],
            "sector-1",
            "#f6c1c5",
            "sector-2",
            "#bfe3c6",
            "sector-3",
            "#c6d7f5",
            "sector-4",
            "#fbd7b0",
            "sector-5",
            "#dcc9ef",
            "sector-6",
            "#bfe9ef",
            "sector-7",
            "#f5c6e6",
            "sector-8",
            "#e3f0b8",
            "sector-9",
            "#bde0d9",
            "sector-11",
            "#e8d6bd",
            "#d8dee8"
          ]
        ],
        "fill-opacity": [
          "case",
          [
            "==",
            [
              "get",
              "selected"
            ],
            true
          ],
          0.82,
          [
            "==",
            [
              "get",
              "dimmed"
            ],
            true
          ],
          0.28,
          0.72
        ]
      }
    },
    {
      "id": "sector-edge",
      "type": "line",
      "source": "areas",
      "slot": "belowLabels",
      "style": "sector-edge",
      "paint": {
        "line-width": [
          "case",
          [
            "==",
            [
              "get",
              "selected"
            ],
            true
          ],
          2.6,
          1.3
        ]
      }
    },
    {
      "id": "port-anchor",
      "type": "symbol",
