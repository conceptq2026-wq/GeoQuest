        ]
      }
    },
    {
      "id": "grave-star",
      "type": "symbol",
      "source": "graves",
      "slot": "aboveLabels",
      "style": "marker",
      "layout": {
        "icon-image": "star",
        "icon-size": [
          "case",
          [
            "==",
            [
              "get",
              "selected"
            ],
            true
          ],
          1.1,
          0.8
        ],
        "symbol-sort-key": [
          "case",
          [
            "==",
            [
              "get",
              "selected"
            ],
            true
          ],
          1,
          0
        ]
      }
