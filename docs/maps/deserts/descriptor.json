{
  "schema": "geoquest/map-descriptor@1",
  "id": "deserts",
  "section": "geography",
  "title": {
    "bn": "বিশ্বের বিখ্যাত মরুভূমি",
    "en": "Famous Deserts of the World"
  },
  "basemap": "world",
  "view": {
    "fitBounds": [-125, -42, 150, 62]
  },
  "constraints": {
    "minZoom": 0,
    "maxZoom": 11
  },
  "lookups": {},
  "records": {
    "deserts": {
      "file": "./records.json",
      "fields": {
        "nameBn": { "type": "text", "required": true },
        "nameEn": { "type": "text", "required": true, "display": false },
        "typeBn": { "type": "text", "verifiable": true },
        "countriesBn": { "type": "text", "verifiable": true },
        "areaBn": { "type": "text", "verifiable": true },
        "noteBn": { "type": "text", "verifiable": true },
        "labelAt": { "type": "point", "required": true },
        "frame": { "type": "bbox", "required": true },
        "photo": { "type": "photo" }
      }
    }
  },
  "sources": {
    "areas": {
      "records": "deserts",
      "geometry": "./areas.geojson",
      "joinField": "id",
      "state": ["selected"],
      "properties": []
    },
    "desertPoints": {
      "records": "deserts",
      "geometryFrom": "labelAt",
      "state": ["selected"],
      "properties": ["nameBn"],
      "selectionMarker": true,
      "photoMarker": { "field": "photo" }
    }
  },
  "styles": {
    "desert-fill": { "paint": { "fill-color": "#e8c98a" } },
    "desert-edge": { "layout": { "line-join": "round" }, "paint": { "line-color": "#b07d3a" } },
    "desert-label": {
      "layout": {
        "text-font": ["Noto Sans Bengali"],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": { "text-color": "#6b4414", "text-halo-color": "#ffffff", "text-halo-width": 2 }
    }
  },
  "layers": [
    {
      "id": "desert-fill",
      "type": "fill",
      "source": "areas",
      "slot": "belowLabels",
      "style": "desert-fill",
      "paint": { "fill-opacity": ["case", ["get", "selected"], 0.72, 0.42] }
    },
    {
      "id": "desert-edge",
      "type": "line",
      "source": "areas",
      "slot": "belowLabels",
      "style": "desert-edge",
      "paint": {
        "line-width": ["case", ["get", "selected"], 2.4, 1],
        "line-opacity": ["case", ["get", "selected"], 1, 0.8]
      }
    },
    {
      "id": "desert-label",
      "type": "symbol",
      "source": "desertPoints",
      "slot": "aboveLabels",
      "style": "desert-label",
      "layout": {
        "text-field": ["get", "nameBn"],
        "text-size": ["case", ["get", "selected"], 15, 13],
        "text-offset": ["case", ["get", "selected"], ["literal", [0, 3]], ["literal", [0, 2.6]]],
        "symbol-sort-key": ["case", ["get", "selected"], 0, 1]
      }
    }
  ],
  "controls": [
    {
      "type": "picker",
      "id": "desert",
      "from": "deserts",
      "placeholder": "একটি মরুভূমি বেছে নিন…",
      "labelEn": "Choose a desert",
      "label": { "field": "nameBn" },
      "do": [{ "action": "select" }, { "action": "fitBounds", "clear": ["sheet"], "duration": 1800, "field": "frame" }]
    }
  ],
  "interactions": [
    {
      "on": "click",
      "target": "source:desertPoints",
      "do": [{ "action": "select" }, { "action": "fitBounds", "clear": ["sheet"], "duration": 1800, "field": "frame" }]
    },
    {
      "on": "click",
      "target": "source:areas",
      "do": [{ "action": "select" }, { "action": "fitBounds", "clear": ["sheet"], "duration": 1800, "field": "frame" }]
    }
  ],
  "sheet": {
    "photo": { "field": "photo" },
    "kicker": { "field": "typeBn" },
    "title": { "field": "nameBn" },
    "rows": [
      { "label": "দেশ", "field": "countriesBn" },
      { "label": "আয়তন", "field": "areaBn" },
      { "label": "বিবরণ", "field": "noteBn" }
    ]
  }
}
