{
  "schema": "geoquest/map-descriptor@1",
  "id": "waterfalls",
  "section": "geography",
  "title": {
    "bn": "বিশ্বের বিখ্যাত জলপ্রপাত",
    "en": "Famous Waterfalls of the World"
  },
  "basemap": "world",
  "view": {
    "fitBounds": [
      -125,
      -42,
      150,
      62
    ]
  },
  "constraints": {
    "minZoom": 0,
    "maxZoom": 11
  },
  "lookups": {},
  "records": {
    "waterfalls": {
      "file": "./records.json",
      "fields": {
        "groupBn": {
          "type": "text",
          "required": true
        },
        "nameBn": {
          "type": "text",
          "required": true
        },
        "nameEn": {
          "type": "text",
          "required": true,
          "display": false
        },
        "typeBn": {
          "type": "text",
          "verifiable": true
        },
        "countriesBn": {
          "type": "text",
          "required": true
        },
        "heightBn": {
          "type": "text",
          "verifiable": true
        },
        "noteBn": {
          "type": "text",
          "verifiable": true
        },
        "labelAt": {
          "type": "point",
          "required": true
        },
        "hasArea": {
          "type": "boolean",
          "required": true
        },
        "frame": {
          "type": "bbox",
          "required": true
        },
        "photo": {
          "type": "photo"
        }
      }
    }
  },
  "sources": {
    "points": {
      "records": "waterfalls",
      "geometryFrom": "labelAt",
      "state": [
        "selected"
      ],
      "properties": [
        "nameBn"
      ],
      "selectionMarker": true,
      "photoMarker": {
        "field": "photo"
      },
      "attribution": "<a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener noreferrer\">© OpenStreetMap contributors</a>"
    }
  },
  "styles": {
    "label": {
      "layout": {
        "text-font": [
          "Noto Sans Bengali"
        ],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": {
        "text-color": "#13233a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    }
  },
  "layers": [
    {
      "id": "label",
      "type": "symbol",
      "source": "points",
      "slot": "aboveLabels",
      "style": "label",
      "layout": {
        "text-field": [
          "get",
          "nameBn"
        ],
        "text-size": [
          "case",
          [
            "get",
            "selected"
          ],
          15,
          12.5
        ],
        "text-offset": [
          "case",
          [
            "get",
            "selected"
          ],
          [
            "literal",
            [
              0,
              3
            ]
          ],
          [
            "literal",
            [
              0,
              2.6
            ]
          ]
        ],
        "symbol-sort-key": [
          "case",
          [
            "get",
            "selected"
          ],
          0,
          1
        ]
      }
    }
  ],
  "controls": [
    {
      "type": "picker",
      "id": "waterfalls",
      "from": "waterfalls",
      "groupBy": {
        "field": "groupBn",
        "order": [
          "আফ্রিকা",
          "এশিয়া",
          "উত্তর আমেরিকা",
          "দক্ষিণ আমেরিকা"
        ]
      },
      "placeholder": "একটি জলপ্রপাত বেছে নিন…",
      "labelEn": "Choose a waterfall",
      "label": {
        "field": "nameBn"
      },
      "do": [
        {
          "action": "select"
        },
        {
          "action": "fitBounds",
          "clear": [
            "sheet"
          ],
          "duration": 1800,
          "field": "frame"
        }
      ]
    }
  ],
  "interactions": [
    {
      "on": "click",
      "target": "source:points",
      "do": [
        {
          "action": "select"
        },
        {
          "action": "fitBounds",
          "clear": [
            "sheet"
          ],
          "duration": 1800,
          "field": "frame"
        }
      ]
    }
  ],
  "sheet": {
    "photo": {
      "field": "photo"
    },
    "kicker": {
      "field": "typeBn"
    },
    "title": {
      "field": "nameBn"
    },
    "rows": [
      {
        "label": "দেশ",
        "field": "countriesBn"
      },
      {
        "label": "উচ্চতা",
        "field": "heightBn"
      },
      {
        "label": "বিবরণ",
        "field": "noteBn"
      }
    ]
  }
}
