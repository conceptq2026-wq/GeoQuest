      "paint": {
        "text-color": "#13213b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5,
        "text-halo-blur": 0.5
      }
    }
  },
  "layers": [
    {
      "id": "solo-glow",
      "type": "circle",
      "source": "solo",
      "slot": "aboveLabels",
      "style": "marker-glow",
      "filter": [
        "==",
        [
          "get",
          "selected"
        ],
        true
      ]
    },
    {
      "id": "place-glow",
      "type": "circle",
      "source": "places",
      "slot": "aboveLabels",
      "style": "marker-glow",
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "selected"
          ],
          true
        ],
        [
          "==",
          [
            "get",
            "active"
          ],
          true
        ]
      ]
    },
    {
      "id": "solo-points",
      "type": "circle",
      "source": "solo",
      "slot": "aboveLabels",
      "style": "marker",
      "filter": [
        "!=",
        [
          "get",
          "selected"
        ],
        true
      ]
    },
    {
      "id": "place-points",
      "type": "circle",
      "source": "places",
      "slot": "aboveLabels",
      "style": "marker",
      "filter": [
        "all",
        [
          "!=",
          [
            "get",
            "selected"
          ],
          true
        ],
        [
          "!=",
          [
            "get",
            "active"
          ],
          true
        ]
      ]
    },
    {
      "id": "solo-selected",
      "type": "circle",
      "source": "solo",
      "slot": "aboveLabels",
      "style": "marker-selected",
      "filter": [
        "==",
        [
          "get",
          "selected"
        ],
        true
      ]
    },
    {
      "id": "place-selected",
      "type": "circle",
      "source": "places",
      "slot": "aboveLabels",
      "style": "marker-selected",
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "selected"
          ],
          true
        ],
        [
          "==",
          [
            "get",
            "active"
          ],
          true
        ]
      ]
    },
    {
      "id": "solo-label",
      "type": "symbol",
      "source": "solo",
      "slot": "aboveLabels",
      "style": "city-label",
      "layout": {
        "text-field": [
          "get",
          "cityEn"
        ],
        "text-radial-offset": [
          "case",
          [
            "==",
            [
              "get",
              "selected"
            ],
            true
          ],
          1.05,
          0.75
        ],
        "symbol-sort-key": [
          "case",
          [
            "==",
            [
              "get",
              "selected"
            ],
            true
          ],
          0,
          1
        ]
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "places",
      "slot": "aboveLabels",
      "style": "city-label",
      "layout": {
        "text-field": [
          "get",
          "nameEn"
        ],
        "text-radial-offset": [
          "case",
          [
            "any",
            [
              "==",
              [
                "get",
                "selected"
              ],
              true
            ],
            [
              "==",
              [
                "get",
                "active"
              ],
              true
            ]
          ],
          1.05,
          0.75
        ],
        "symbol-sort-key": [
          "case",
          [
            "any",
            [
              "==",
              [
                "get",
                "selected"
              ],
              true
            ],
            [
              "==",
              [
                "get",
                "active"
              ],
              true
            ]
          ],
          0,
          1
        ]
      }
    }
  ],
  "controls": [],
  "interactions": [
    {
      "on": "click",
      "target": "source:solo",
      "do": [
        {
          "action": "select"
        },
        {
          "action": "fitBounds",
          "clear": [
            "sheet"
          ],
          "duration": 1800,
          "field": "frame"
        }
      ]
    },
    {
      "on": "click",
      "target": "source:places",
      "do": [
        {
          "action": "select"
        },
        {
          "action": "fitBounds",
          "clear": [
            "sheet"
          ],
          "duration": 1800,
          "field": "frame"
        }
      ]
    }
  ],
  "tabs": {
    "records": "items",
    "field": "tab",
    "from": "tabs",
    "label": {
      "field": "titleEn"
    }
  },
  "timeline": {
    "records": "items",
    "at": "year",
    "label": {
      "field": "shortEn"
    },
    "rowBy": "themeBn",
    "rowLabel": {
      "compose": [
        "{themeEn}",
        "{tabEn}"
      ]
    },
    "colour": {
      "style": "marker",
      "paint": "circle-color"
    },
    "state": [
      "selected",
      {
        "name": "active",
        "fromSelection": {
          "records": "places",
          "listField": "records"
        }
      }
    ],
    "do": [
      {
        "action": "select"
      },
      {
        "action": "fitBounds",
        "clear": [
          "sheet"
        ],
        "duration": 1800,
        "field": "frame"
      }
    ]
  },
  "sheets": {
    "items": {
      "chip": {
        "field": "themeEn"
      },
      "title": {
        "field": "nameEn"
      },
      "columns": 2,
      "rows": [
        {
          "label": "Adopted",
          "field": "year",
          "when": {
            "tab": [
              "conventions",
              "treaties"
            ]
          }
        },
        {
          "label": "Held",
          "field": "year",
          "when": {
            "tab": [
              "summits",
              "cops"
            ]
          }
        },
        {
          "label": "In force",
          "field": "inForceYear"
        },
        {
          "label": "Place",
          "compose": [
            "{cityEn}, {countryEn}",
            "{countryEn}"
          ],
          "short": {
            "compose": [
              "{cityEn}",
              "{countryEn}"
            ]
          }
        },
        {
          "label": "Under",
          "referencedBy": {
            "records": "items",
            "listField": "children"
          },
          "item": {
            "field": "shortEn"
          },
          "do": [
            {
              "action": "select"
            },
            {
              "action": "fitBounds",
              "clear": [
                "sheet"
              ],
              "duration": 1800,
              "field": "frame"
            }
          ]
        },
        {
          "label": "Under",
          "field": "parentShortEn"
        },
        {
          "field": "noteEn",
          "stacked": true
        }
      ]
    },
    "places": {
      "title": {
        "compose": [
          "{nameEn}, {countryEn}",
          "{nameEn}"
        ]
      },
      "rows": [
        {
          "referencedBy": {
            "records": "items",
            "listField": "place"
          },
          "item": {
            "field": "shortEn"
          },
          "do": [
            {
              "action": "select"
            },
            {
              "action": "fitBounds",
              "clear": [
                "sheet"
              ],
              "duration": 1800,
              "field": "frame"
            }
          ]
        }
      ]
    }
  },
  "lookups": {}
