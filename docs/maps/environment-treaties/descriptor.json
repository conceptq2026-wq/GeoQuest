  "sources": {
    "solo": {
      "records": "items",
      "geometryFrom": "soloAt",
      "properties": [
        "themeBn",
        "tab",
        "cityEn"
      ],
      "state": [
        "selected"
      ]
    },
    "places": {
      "records": "places",
      "geometryFrom": "at",
      "properties": [
        "themeBn",
        "tab",
        "nameEn"
      ],
      "state": [
        "selected",
        {
          "name": "active",
          "fromSelection": {
            "records": "items",
            "listField": "place"
          }
        }
      ]
    }
  },
  "styles": {
    "marker": {
      "paint": {
        "circle-color": [
