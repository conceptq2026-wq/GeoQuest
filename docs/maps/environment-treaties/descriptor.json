        ],
        "circle-radius": 19,
        "circle-blur": 0.85,
        "circle-opacity": 0.6
      }
    },
    "city-label": {
      "layout": {
        "text-font": [
          "Noto Sans Bengali"
        ],
        "text-size": 12.5,
        "text-variable-anchor": [
          "left",
          "right"
        ],
        "text-justify": "auto"
