        "circle-stroke-color": "#ffffff"
      }
    },
    "marker-glow": {
      "paint": {
        "circle-color": [
          "match",
          [
            "get",
            "themeBn"
          ],
          "জলাভূমি ও ঐতিহ্য",
          "#16a3a0",
          "বন্যপ্রাণী ও জীববৈচিত্র্য",
          "#3fae4a",
          "ওজোন স্তর",
