    },
    "places": {
      "file": "./places.json",
      "fields": {
        "nameBn": {
          "type": "text",
          "required": true,
          "display": false
        },
        "nameEn": {
          "type": "text",
          "required": true
        },
        "countryBn": {
          "type": "text",
          "required": true,
          "display": false
        },
